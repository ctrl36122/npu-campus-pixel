[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://net/autoload/GameState.gd" id="script"]

[sub_resource type="SceneReplicationConfig" id="replication"]
properties/0/path = NodePath(".:phase")
properties/0/spawn = true
properties/0/replication_mode = 1
properties/1/path = NodePath(".:round_id")
properties/1/spawn = true
properties/1/replication_mode = 1
properties/2/path = NodePath(".:seconds_left")
properties/2/spawn = true
properties/2/replication_mode = 1

[node name="GameState" type="Node"]
script = ExtResource("script")

[node name="Sync" type="MultiplayerSynchronizer" parent="."]
replication_interval = 0.1
replication_config = SubResource("replication")
